# ============================================================================
# FreshBlox environment
# ============================================================================
# Copy to `.env.local` for local development and set the same values in Vercel.
# `.env.local` is git-ignored; never commit real secrets.

# --- Client (bundled into the browser, must be PUBLIC) ----------------------
# Leave both empty to run the guest-only experience (Blok Brawl, Parkour, Turbo
# Kart practice) without accounts.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Server only (used by api/register-account.js; never exposed to the client) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# HMAC salt for the device-lock hashes (device token, browser fingerprint, IP).
# Required, at least 32 characters, random and stable: rotating it invalidates
# every stored device lock, and a missing value makes the endpoint refuse to
# register anyone instead of hashing with a predictable constant.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
FRESHBLOX_FP_SALT=

# Optional: extra browser origins allowed to call the registration endpoint
# (comma separated). The deployment's own origin is always allowed.
# Example: https://staging.freshblox.app
FRESHBLOX_ALLOWED_ORIGINS=

# Optional: where `npm run dev` proxies /api (defaults to the local dev-api server).
# FRESHBLOX_DEV_API_URL=http://127.0.0.1:8787
